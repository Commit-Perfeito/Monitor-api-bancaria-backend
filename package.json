{
  "name": "monitor-api-bancaria",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "up": "docker-compose up --build",
    "down": "docker compose down -v",
    "build": "tsup src",
    "dev": "docker start monitor-db && nodemon --exec \"ts-node -r tsconfig-paths/register\" ./src/shared/infra/http/server.ts",
    "start": "node dist/shared/infra/http/server.js",
    "test": "jest",
    "migration:create": "typeorm-ts-node-commonjs migration:create src/shared/database/migrations/default",
    "migration:generate": "typeorm-ts-node-commonjs -d ./src/data-source.ts migration:generate ./src/shared/database/migrations/default",
    "migration:run": "typeorm-ts-node-commonjs -d ./src/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d ./src/data-source.ts migration:revert",
    "seed:run": "ts-node ./node_modules/typeorm-extension/bin/cli.cjs -d ./src/data-source.ts seed:run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "http-status-codes": "^2.3.0",
    "pg": "^8.12.0",
    "rate-limiter-flexible": "^7.1.1",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsc": "^2.0.4",
    "tsup": "^8.2.4",
    "tsyringe": "^4.10.0",
    "typeorm": "0.3.11",
    "typeorm-extension": "^3.6.2",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/js": "^9.11.0",
    "@types/axios": "^0.14.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.5.4",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.7",
    "eslint": "^9.11.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.9.0",
    "jest": "^30.0.5",
    "nodemon": "^3.1.4",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.0",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.6.0"
  }
}
